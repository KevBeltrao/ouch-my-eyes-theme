{
  "name": "kevbeltrao-ouch-my-eyes",
  "displayName": "Ouch My Eyes",
  "description": "Dark theme focused on high contrast colors",
  "publisher": "KevinBeltrao",
  "version": "0.0.18",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "assets/icon.jpeg",
  "author": {
    "name": "Kevin Beltrão",
    "email": "kevin@kevbeltrao.com.br",
    "url": "https://kevbeltrao.com.br"
  },
  "repository": {
    "url": "https://github.com/KevBeltrao/ouch-my-eyes-theme",
    "type": "git"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "ouch my eyes (classic blue)",
        "uiTheme": "vs-dark",
        "path": "./themes/ouch my eyes-color-theme.json"
      },
      {
        "label": "ouch my eyes (gray)",
        "uiTheme": "hc-black",
        "path": "./themes/ouch my eyes-color-darker-theme.json"
      }
    ]
  },
  "scripts": {
    "publish": "vsce publish --pat $VSCE_TOKEN",
    "publish:ovsx": "ovsx publish kevbeltrao-ouch-my-eyes-$npm_package_version.vsix -p $OPEN_VSX_TOKEN",
    "package": "vsce package",
    "ship": "yarn run package && yarn run publish && yarn run publish:ovsx"
  },
  "devDependencies": {
    "ovsx": "^1.2.0",
    "vsce": "^2.15.0"
  }
}
